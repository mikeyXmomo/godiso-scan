  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "tsc -b && vite build",
    "check": "ultracite check",
    "dev": "vite",
    "fix": "ultracite fix",
